#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define FUN   3
#define MEDIA 4

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            hold-trigger-on-release;
        };

        ltf: layer_tap_fh {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <210>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Q>, <&kp ESC>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_caps {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&kp CAPS>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &td0            &kp W           &kp E           &kp R           &kp T               &kp Y           &kp U           &kp I           &kp O           &kp P
                &hml LGUI A     &hml LALT S     &hml LCTRL D    &hml LSHFT F    &kp G               &kp H           &hmr RSHFT J    &hmr RCTRL K    &hmr LALT L     &hmr RGUI SEMI
                &kp Z           &kp X           &kp C           &kp V           &kp B               &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH
                                                                &ltf LOWER SPACE &ltf RAISE TAB      &ltf FUN RET    &ltf MEDIA BSPC
            >;
        };

        lower_layer {
            bindings = <
                &kp N1          &kp N2          &kp N3          &kp N4          &kp N5              &kp N6          &kp N7          &kp N8          &kp N9          &kp N0
                &kp GRAVE       &kp MINUS       &kp EQUAL       &kp LBKT        &trans              &trans          &kp RBKT        &kp SQT         &kp NUBS        &kp NUHS
                &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHFT       &trans              &trans          &kp RSHFT       &kp RCTRL       &kp LALT        &kp RGUI
                                                                &trans          &trans              &trans          &trans
            >;
        };

        raise_layer {
            bindings = <
                &kp LS(N1)      &kp LS(N2)      &kp LS(N3)      &kp LS(N4)      &kp LS(N5)          &kp LS(N6)      &kp LS(N7)      &kp LS(N8)      &kp LS(N9)      &kp LS(N0)
                &kp LS(GRAVE)   &kp LS(MINUS)   &kp LS(EQUAL)   &kp LS(LBKT)    &trans              &trans          &kp LS(RBKT)    &kp LS(SQT)     &kp LS(NUBS)    &kp LS(NUHS)
                &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHFT       &trans              &trans          &kp RSHFT       &kp RCTRL       &kp LALT        &kp RGUI
                                                                &trans          &trans              &trans          &trans
            >;
        };

        function_layer {
            bindings = <
                &kp F1          &kp F2          &kp F3          &kp F4          &trans              &kp HOME        &kp PG_DN       &kp PG_UP       &kp END         &kp INS
                &kp F5          &kp F6          &kp F7          &kp F8          &trans              &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp DEL
                &kp F9          &kp F10         &kp F11         &kp F12         &trans              &trans          &kp RSHFT       &kp RCTRL       &kp LALT        &kp RGUI
                                                                &trans          &trans              &trans          &trans
            >;
        };

        media_layer {
            bindings = <
                &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_STOP      &trans              &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &mkp LCLK
                &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_BRI_DN    &kp C_BRI_UP        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &mkp MCLK
                &trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &mkp RCLK
                                                                &trans          &trans              &trans          &trans
            >;
        };
    };
};
